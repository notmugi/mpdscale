# Copy to .env and edit. All values are optional — setup.sh will prompt/generate.

# Path to your music library
MUSIC_DIR="$HOME/Music"

# Password MPD clients must supply (generated randomly if left empty)
MPD_PASSWORD=""

# Optional: Tailscale auth key for unattended/headless setup
# Create one at https://login.tailscale.com/admin/settings/keys (reusable, ephemeral recommended)
TAILSCALE_AUTHKEY=""
